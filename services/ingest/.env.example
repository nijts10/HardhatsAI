# Supabase Postgres connection. Use the service_role / direct connection
# string — this worker bypasses RLS by design (see CLAUDE.md invariant 6).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase project, used for Storage access to the supplier-documents bucket.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude: spec extraction + (later) answer generation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI: embeddings only. text-embedding-3-small outputs 1536 dims natively,
# matching document_chunks.embedding vector(1536) with no truncation/padding.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

WORKER_NAME=ingest-worker-1
