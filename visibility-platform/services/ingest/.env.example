# Supabase Postgres connection. Use the service_role / direct connection
# string — this worker bypasses RLS by design (analysts correct claims
# via re-upload + re-extract, not direct edits; see the schema comments).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase project, used for Storage access to the 'documents' bucket.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude: claim extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI: embeddings, AND the "ChatGPT" side of benchmark runs (same key,
# two different uses). The expected dimension count lives in exactly one
# place: EMBEDDING_DIMENSIONS in ingest/config.py (currently 1536, matching
# text-embedding-3-small's native output and document_chunks.embedding's
# column type) -- if you change OPENAI_EMBEDDING_MODEL to something with a
# different native size, update that constant too, and see its comment for
# why the migration itself can't just reference it.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CHECK THIS IS STILL CURRENT before relying on it -- model names go stale
# fast and this file was written 2026-08.
OPENAI_CHAT_MODEL=gpt-4o

# Google: the "Gemini" side of benchmark runs. Get a key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# CHECK THIS IS STILL CURRENT before relying on it, same caveat as above.
GEMINI_MODEL=gemini-2.0-flash

WORKER_NAME=visibility-ingest-worker-1
