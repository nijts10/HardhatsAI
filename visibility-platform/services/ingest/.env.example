# Supabase Postgres connection. Use the service_role / direct connection
# string — this worker bypasses RLS by design (analysts correct claims
# via re-upload + re-extract, not direct edits; see the schema comments).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase project, used for Storage access to the 'documents' bucket.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude: claim extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI: embeddings, AND the "ChatGPT" side of benchmark runs (same key,
# two different uses). The expected dimension count lives in exactly one
# place: EMBEDDING_DIMENSIONS in ingest/config.py (currently 1536, matching
# text-embedding-3-small's native output and document_chunks.embedding's
# column type) -- if you change OPENAI_EMBEDDING_MODEL to something with a
# different native size, update that constant too, and see its comment for
# why the migration itself can't just reference it.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CHECK THIS IS STILL CURRENT before relying on it -- model names go stale
# fast and this file was written 2026-08.
OPENAI_CHAT_MODEL=gpt-4o

# Google: the "Gemini" side of benchmark runs. Get a key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# CHECK THIS IS STILL CURRENT before relying on it, same caveat as above.
GEMINI_MODEL=gemini-2.0-flash

WORKER_NAME=visibility-ingest-worker-1

# MVP brief Part 3's benchmark engine (`ingest.cli benchmark`, ingest/
# visibility.py) -- deliberately SEPARATE from ANTHROPIC_MODEL/
# OPENAI_CHAT_MODEL/GEMINI_MODEL above. Those are for extraction and the
# old plain-chat-completion run-benchmark command; this is standing in for
# what a real end user sees in each provider's actual chat product with
# web search/grounding turned on, which may reasonably want a different
# model. Reuses the same ANTHROPIC_API_KEY/OPENAI_API_KEY/GOOGLE_API_KEY
# above -- only the model differs.
# CHECK THESE ARE STILL CURRENT before relying on them, same caveat as
# OPENAI_CHAT_MODEL/GEMINI_MODEL above.
VISIBILITY_ANTHROPIC_MODEL=claude-sonnet-5
VISIBILITY_OPENAI_MODEL=gpt-4o
VISIBILITY_GEMINI_MODEL=gemini-2.0-flash

# Hard-abort knobs for `ingest.cli benchmark`, checked before every answer
# (not just once): a run stops -- without being marked failed, so it's
# resumable with --resume-run -- the moment the NEXT answer would push it
# over either number. VISIBILITY_MAX_ANSWERS_PER_RUN counts answers made in
# THIS invocation only, not the run's lifetime total. Pricing behind the
# cost estimate is approximate -- see PRICING_USD_PER_1M_TOKENS in
# ingest/visibility.py.
VISIBILITY_MAX_ANSWERS_PER_RUN=500
VISIBILITY_COST_CEILING_USD=50
